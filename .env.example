# Copy to .env and fill in. Never commit .env.

# --- Model access (OpenAI-compatible endpoint; DeepSeek by default) ---
PERIPLUS_LLM_BASE_URL=https://api.deepseek.com
PERIPLUS_LLM_API_KEY=
# Fallback for any stage without an explicit override.
PERIPLUS_LLM_MODEL=deepseek-v4-flash
# Per-stage overrides. Verification deliberately runs on the cheap, literal model.
PERIPLUS_LLM_MODEL_RESEARCH=deepseek-v4-pro
PERIPLUS_LLM_MODEL_VERIFY=deepseek-v4-flash
PERIPLUS_LLM_MODEL_PLAN=deepseek-v4-pro
PERIPLUS_LLM_MODEL_WRITE=deepseek-v4-pro
PERIPLUS_LLM_MODEL_EDIT=deepseek-v4-pro

PERIPLUS_LLM_TIMEOUT_SECONDS=120
PERIPLUS_LLM_MAX_ATTEMPTS=3
PERIPLUS_LLM_RETRY_BACKOFF_SECONDS=1.0

# --- Search (DeepSeek has no browsing; discovery is a separate dependency) ---
PERIPLUS_TAVILY_API_KEY=
# ultra-fast | fast | basic | advanced. Costs 1 credit, except advanced at 2.
PERIPLUS_SEARCH_DEPTH=basic
PERIPLUS_RESULTS_PER_QUERY=6

# --- Geo (Navigator's real distances; unset falls back to the model's guess) ---
# OpenRouteService is preferred when set — free key, no billing account required.
PERIPLUS_ORS_API_KEY=
PERIPLUS_GOOGLE_MAPS_API_KEY=

# --- Illustration (Agnes is preferred when both are set) ---
PERIPLUS_AGNES_API_KEY=
PERIPLUS_AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# Agnes docs: generation can take tens of seconds; own timeout, not the 30s fetch default.
PERIPLUS_AGNES_IMAGE_TIMEOUT_SECONDS=120
PERIPLUS_OPENAI_API_KEY=
PERIPLUS_ILLUSTRATION_IMAGE_MODEL=gpt-image-1
PERIPLUS_ILLUSTRATION_IMAGE_SIZE=1024x1024
# low | medium | high | auto.
PERIPLUS_ILLUSTRATION_IMAGE_QUALITY=auto
# Distinct subjects illustrated per run.
PERIPLUS_MAX_ILLUSTRATIONS=6
# Attempts per subject, transient provider failures only; 1 disables retry. Both image
# providers run with the SDK's own retries off, so this is the only retry in that path.
PERIPLUS_ILLUSTRATION_MAX_ATTEMPTS=2
PERIPLUS_ILLUSTRATION_RETRY_BACKOFF_SECONDS=1.0

# --- Fetching ---
# The page cache is what makes prompt iteration cheap: same URL, fetched once, ever.
PERIPLUS_PAGE_CACHE_ENABLED=true
PERIPLUS_PAGE_CACHE_DIR=data/pages
PERIPLUS_PAGE_CACHE_TTL_DAYS=30
PERIPLUS_MAX_PAGE_BYTES=2000000
PERIPLUS_PER_HOST_DELAY_SECONDS=1.0
PERIPLUS_MAX_CONCURRENT_FETCHES=6
PERIPLUS_OBEY_ROBOTS=true
PERIPLUS_MAX_CHARS_PER_DOCUMENT=24000

# --- Storage ---
PERIPLUS_DATABASE_URL=postgresql://localhost/periplus

# --- Evidence cache (pgvector semantic reuse in front of retrieval) ---
# Reuses a near-identical source instead of re-fetching it. Local
# sentence-transformers only — never a paid embedding API. Missing that
# dependency disables the cache on its own; retrieval then runs as before.
PERIPLUS_EVIDENCE_CACHE_ENABLED=true
PERIPLUS_EVIDENCE_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Cosine similarity above which a cached source counts as the same source.
# Higher is more conservative.
PERIPLUS_EVIDENCE_CACHE_SIMILARITY_THRESHOLD=0.90

# --- Run limits ---
PERIPLUS_MAX_RESEARCH_QUERIES=12
PERIPLUS_MAX_RESEARCH_DOCUMENTS=24
PERIPLUS_MAX_RESEARCH_DOCUMENT_CHARS=120000
PERIPLUS_RESEARCH_DOCUMENTS_PER_BATCH=6
PERIPLUS_RESEARCH_CHARS_PER_BATCH=60000
# Shared by Explorer's evidence merge and Auditor's per-claim input guard.
PERIPLUS_MAX_EVIDENCE_PER_CLAIM=5
# Auditor groups each claim with all of its cited evidence; no source is silently truncated.
PERIPLUS_VERIFICATION_CLAIMS_PER_BATCH=8
PERIPLUS_VERIFICATION_CHARS_PER_BATCH=30000
PERIPLUS_MAX_VERIFICATION_CLAIMS=100
PERIPLUS_MAX_VERIFICATION_INPUT_CHARS=120000
PERIPLUS_MAX_NAVIGATION_PLACES=40
PERIPLUS_MAX_NAVIGATION_CLAIMS=200
PERIPLUS_MAX_CONTENT_ITEMS=60
PERIPLUS_MAX_CONTENT_CLAIMS=200
PERIPLUS_MAX_CONTENT_PIECES=12
PERIPLUS_MAX_CONTENT_PIECE_CHARS=8000
# Editor rewrites what Chronicler produced, so its ceilings track the pair above.
PERIPLUS_MAX_EDIT_PIECES=12
PERIPLUS_MAX_EDIT_PIECE_CHARS=8000
PERIPLUS_MAX_EDIT_INPUT_CHARS=40000
PERIPLUS_REQUEST_TIMEOUT_SECONDS=30
PERIPLUS_USER_AGENT=periplus/0.1 (+https://github.com/parthenon-labs/periplus)

# --- Orchestration (Hermes) ---
# Run-wide ceilings across every stage, enforced between stages, not mid-call.
# Unset (the default) is unbounded; uncomment to cap a run.
# PERIPLUS_MAX_RUN_QUERIES=200
# PERIPLUS_MAX_RUN_FETCHES=200
# PERIPLUS_MAX_RUN_TOKENS=500000
# PERIPLUS_MAX_RUN_WALL_CLOCK_SECONDS=900
PERIPLUS_STAGE_MAX_ATTEMPTS=2
PERIPLUS_STAGE_RETRY_BACKOFF_SECONDS=1.0
# When verification leaves claims unconfirmed, research runs one targeted second pass
# over those subjects and verification re-runs over the merged bundle. Both passes are
# ordinary stage attempts charged against the run ceilings above. false makes the
# pipeline strictly forward again.
PERIPLUS_RESEARCH_FOLLOWUP_ENABLED=true
PERIPLUS_MAX_FOLLOWUP_SUBJECTS=5
