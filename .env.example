# Copy to .env and fill in. Never commit .env.

# --- Model access (OpenAI-compatible endpoint) ---
PERIPLUS_LLM_BASE_URL=https://api.openai.com/v1
PERIPLUS_LLM_API_KEY=
PERIPLUS_LLM_MODEL=gpt-4o-mini
# Stage overrides; fall back to PERIPLUS_LLM_MODEL when unset.
PERIPLUS_LLM_MODEL_RESEARCH=
PERIPLUS_LLM_MODEL_VERIFY=
PERIPLUS_LLM_MODEL_PLAN=
PERIPLUS_LLM_MODEL_WRITE=

# --- Storage ---
PERIPLUS_DATABASE_URL=postgresql://localhost/periplus

# --- Run limits ---
PERIPLUS_MAX_RESEARCH_QUERIES=12
PERIPLUS_MAX_EVIDENCE_PER_CLAIM=5
PERIPLUS_REQUEST_TIMEOUT_SECONDS=30
PERIPLUS_USER_AGENT=periplus/0.1 (+https://github.com/parthenon-labs/periplus)
